{
  "name": "next-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "launch": "bun run build && bun run start",
    "format": "bunx prettier . --write",
    "lint-format": "bun run lint && bun run format",
    "heroui": "bunx --package npm@10 npm exec -- heroui",
    "heroui:install": "bun run heroui install",
    "heroui:doctor": "bun run heroui doctor",
    "heroui:list": "bun run heroui list",
    "heroui:upgrade": "bun run heroui upgrade",
    "heroui:agents": "bun run heroui agents-md --react --output AGENTS.md",
    "pre-commit": "bun run test && bun run lint-format",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "vitest run --dir tests/unit --passWithNoTests",
    "test:integration": "vitest run --dir tests/integration --disable-console-intercept --passWithNoTests",
    "test:e2e": "bun run build && start-server-and-test start http://localhost:3000 \"bunx playwright test\"",
    "test:specific": "bunx playwright test -g",
    "playwright": "bunx playwright test --ui"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@paper-design/shaders-react": "^0.0.81",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "dotenv": "^17.2.3",
    "next": "^16.0.7",
    "react": "19.1.0",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "heroui-cli": "^3.0.4",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
