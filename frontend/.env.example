# Root URL of the FastAPI X-Ray service (../backend).
# Leave it unset to read the JSON dataset bundled in src/data/xray.
# XRAY_API_URL="http://localhost:8000"

# Vercel AI Gateway: server-only; never prefix with NEXT_PUBLIC_.
# Without a key, Nexo automatically uses deterministic demo responses.
# AI_GATEWAY_API_KEY="your-key"

# Optional: mock forces the demo even with a key; gateway requires a key.
# ASSISTANT_MODE="mock"
